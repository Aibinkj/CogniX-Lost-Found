# ---------------------------------------------------------------------------
# Lost & Found AI Agent - example environment file
# Copy to `.env` and fill in. Never commit a real `.env`.
# ---------------------------------------------------------------------------

# --- Database -------------------------------------------------------------
# Any PostgreSQL instance. Use the docker-compose one for pgvector support:
#   postgresql+psycopg2://lostfound:lostfound@localhost:5433/lostfound
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/lostfound

# auto  -> use pgvector if the `vector` extension can be created, else fall back
# pgvector -> require pgvector (fail loudly if missing)
# numpy -> always store embeddings as REAL[] and rank in Python
VECTOR_BACKEND=auto

# --- Embeddings -----------------------------------------------------------
# auto -> sentence-transformers if installed, else the deterministic hashing
#         embedder (works offline, no model download)
EMBEDDING_BACKEND=auto
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384

# --- LLM ------------------------------------------------------------------
# openai    -> any OpenAI-compatible /chat/completions endpoint
#              (OpenAI, OpenRouter, Groq, Together, vLLM, Ollama, LM Studio)
# anthropic -> Anthropic Messages API
# none      -> no LLM; the agent uses its deterministic rule-based extractor
LLM_PROVIDER=none
LLM_MODEL=meta-llama/llama-3.3-70b-instruct
LLM_API_KEY=
# Base URL for the openai provider. Examples:
#   https://api.openai.com/v1
#   https://openrouter.ai/api/v1
#   http://localhost:11434/v1        (Ollama)
LLM_BASE_URL=https://api.openai.com/v1
LLM_TEMPERATURE=0.0
LLM_TIMEOUT_SECONDS=30
# openai provider only, sent when non-empty. Thinking models (Gemini 3.x,
# OpenAI o-series) can spend the whole token budget reasoning and truncate the
# JSON reply; extraction is simple, so turn reasoning down.
#   Google AI Studio: LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#                     LLM_MODEL=gemini-3.5-flash  LLM_REASONING_EFFORT=none
LLM_REASONING_EFFORT=

# --- Matching / safety thresholds ----------------------------------------
CONFIDENCE_HIGH_THRESHOLD=0.75
CONFIDENCE_LOW_THRESHOLD=0.60
# Two candidates within this score gap are treated as ambiguous.
AMBIGUITY_MARGIN=0.07
SEARCH_TOP_K=5

# Confidence signal weights (must sum to 1.0).
WEIGHT_SEMANTIC=0.50
WEIGHT_LOCATION=0.20
WEIGHT_TIME=0.15
WEIGHT_CATEGORY=0.10
WEIGHT_BRAND=0.05

# Ownership verification: fraction of a hidden feature that must be matched.
VERIFICATION_THRESHOLD=0.55
# Optional LLM assist for verification. When true, ONLY the single candidate's
# hidden feature strings are sent to the LLM, never the whole database.
VERIFICATION_USE_LLM=false

# Help questions ("how do I reach staff?") are answered only from a help article
# retrieved at or above this similarity; below it the agent says it doesn't know.
HELP_MIN_SIMILARITY=0.30

# --- Observability (optional) --------------------------------------------
# Leave blank to disable. The app runs normally without Langfuse.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# --- App ------------------------------------------------------------------
API_URL=http://localhost:8000
LOG_LEVEL=INFO
